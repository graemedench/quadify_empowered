+    app._on_state(PlayerState(status="stop"), PlayerState(status="play", service="mpd"))
+    assert app.fsm.current.name == "clock"
+    assert app._playback_settle_timer is not None
+    _set(app, status="play", service="mpd")
+    app._last_switch_t = 0
+    app._playback_settle_fire()
+    assert app.fsm.current.name == "modern"
