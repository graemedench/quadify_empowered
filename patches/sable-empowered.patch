+import sys
+from pathlib import Path
+from unittest.mock import Mock, patch
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from sable.volumio.listener import VolumioListener
+from sable.screens.menu import MenuScreen
+from sable.app import build_sim_app
+from sable.settings import DEFAULTS, _deep_merge
+from PIL import Image, ImageDraw
+
+
+def test_refresh_schedule_and_rip_guard():
+    listener = VolumioListener(Mock(), log=lambda *a: None)
+    listener.sio = Mock(connected=True)
+    listener._library_refresh_at = 0
+    with patch("sable.cd_rip._BUSY") as busy, patch("sable.volumio.listener.time.monotonic", return_value=901):
+        busy.locked.return_value = False
+        listener.tick_library_refresh(899, 15)
+        listener.sio.emit.assert_not_called()
+        listener.tick_library_refresh(901, 15)
+        listener.sio.emit.assert_called_once_with("updateDb")
+        listener.sio.emit.reset_mock()
+        busy.locked.return_value = True
+        listener.tick_library_refresh(1802, 15)
+        listener.sio.emit.assert_not_called()
+        busy.locked.return_value = False
+        listener.sio.connected = False
+        assert listener.refresh_library() == "unavailable"
+        listener.sio.emit.assert_not_called()
+        listener.tick_library_refresh(1900, 0)
+        assert listener._library_refresh_at == 1900
+
+
+def test_menu_and_saved_preference():
+    assert _deep_merge(DEFAULTS, {"library": {"refresh_minutes": 15}})["library"]["refresh_minutes"] == 15
+    app = build_sim_app(frames_dir=None)
+    app.display.ascii_preview = False
+    app.listener = Mock()
+    app.listener.refresh_library.return_value = "requested"
+    app.show_osd = Mock()
+    menu = app.fsm.screens["menu"]
+    menu._refresh_library()
+    app.listener.refresh_library.assert_called_once()
+    app.show_osd.assert_called_with("MUSIC LIBRARY", "REFRESH REQUESTED")
+    with patch.object(menu, "_storage_rows", return_value=[("Internal Storage", 200000000000, 250000000000), ("USB: Music", 3000000000, 16000000000)]):
+        menu._show_storage()
+        assert menu._cur["items"][0][2]() == "200.0 GB free"
+        assert menu._cur["items"][1][2]() == "3.0 GB free"
+        menu._cur["items"][0][1]()
+        app.show_osd.assert_called_with("STORAGE", "200.0 / 250.0 GB FREE")
+    with patch.object(menu, "_storage_rows", return_value=[]):
+        menu._show_storage()
+        assert menu._cur["items"][0][0] == "No storage available"
+
+if __name__ == "__main__":
+    for name, test in sorted(globals().copy().items()):
+        if name.startswith("test_"):
+            test(); print("PASS", name)
