+            return node
+
+    def set(self, *path_and_value):
+        *path, value = path_and_value
+        with self._lock:
+            node = self._data
+            for key in path[:-1]:
+                node = node.setdefault(key, {})
+            node[path[-1]] = value
+            self.save()
+
+    def reset_shortcuts(self):
+        """Restore buttons 5-7 without disturbing other panel preferences."""
+        with self._lock:
