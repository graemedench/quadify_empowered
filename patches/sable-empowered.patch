+existing music is never overwritten. Track WAVs are temporary and encoders run
+one at a time. HQ is original-resolution lossless FLAC; MP3 is 320 kbit/s.
+"""
+import fcntl
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import threading
+import time
+
+_BUSY = threading.Lock()
+_CANCEL = threading.Event()
+LOCK_FILE = '/tmp/sable-cd-rip.lock'
+_PROGRESS = {}
+
+def progress_snapshot():
+    return dict(_PROGRESS)
+
+
+
+class RipCancelled(Exception):
+    pass
+
+
+def cancel_rip():
+    if not _BUSY.locked():
+        return False
+    _CANCEL.set()
+    return True
+
+
+def _run_command(args, timeout, on_poll=None):
+    """Drain child output while allowing cancellation to stop reading/encoding."""
+    if _CANCEL.is_set():
+        raise RipCancelled()
+    process = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+    deadline = time.monotonic() + timeout
+    try:
+        while True:
+            if _CANCEL.is_set():
+                raise RipCancelled()
+            if time.monotonic() >= deadline:
+                raise subprocess.TimeoutExpired(args, timeout)
+            if on_poll:
+                on_poll()
+            try:
+                _, stderr = process.communicate(timeout=0.2)
+            except subprocess.TimeoutExpired:
+                continue
+            if process.returncode:
+                raise subprocess.CalledProcessError(process.returncode, args, stderr=stderr)
+            return
+    finally:
+        if process.poll() is None:
+            process.terminate()
+            try:
+                process.communicate(timeout=3)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.communicate()
+
+STATUS_FILE = Path(__file__).resolve().parents[2] / 'config' / 'cd-rip-status.json'
+
+
+def destination_path(drive):
+    # Volumio mounts are aliases: INTERNAL -> /data/INTERNAL; USB -> /media.
+    # Resolve the allowed roots as well as the selected path before comparing.
+    raw = drive.get('path')
+    if not isinstance(raw, str) or not raw:
+        raise RuntimeError('Destination unavailable')
+    destination = Path(raw).resolve()
+    internal = Path('/mnt/INTERNAL').resolve()
+    usb = Path('/mnt/USB').resolve()
+    is_internal = destination == internal
+    is_usb = destination != usb and destination.is_relative_to(usb)
+    if not destination.is_dir() or not (is_internal or is_usb):
+        raise RuntimeError('Destination unavailable')
+    if is_usb and not os.path.ismount(destination):
+        raise RuntimeError('USB drive is no longer mounted')
+    return destination
+
+
+def library_path(drive):
+    destination = destination_path(drive)
+    internal = Path('/mnt/INTERNAL').resolve()
+    if destination == internal:
+        return 'INTERNAL/CD Rips'
+    usb = Path('/mnt/USB').resolve()
+    return str(Path('USB') / destination.relative_to(usb) / 'CD Rips')
+
+
+def read_fraction(wav, pcm_bytes):
+    try:
+        return min(1.0, max(0.0, (Path(wav).stat().st_size - 44) / max(1, pcm_bytes)))
+    except OSError:
+        return 0.0
+
+
+def encode_fraction(progress_file, duration):
+    try:
+        values = dict(line.split('=', 1) for line in Path(progress_file).read_text().splitlines() if '=' in line)
+        if values.get('progress') == 'end':
+            return 1.0
+        return min(1.0, max(0.0, float(values.get('out_time_us', 0)) / (max(.001, duration) * 1000000)))
+    except (OSError, ValueError):
+        return 0.0
+
+
+def prepare_rip_info(navigation):
+    """Use browse metadata plus the drive TOC; avoid Volumio's abcde lookup."""
+    if not isinstance(navigation, dict) or not (navigation.get('rip') or {}).get('enabled'):
+        raise RuntimeError('Ripping unavailable for this disc')
+    meta = navigation.get('info') or {}
+    if meta.get('service') != 'cd_controller':
+        raise RuntimeError('Reopen Audio CD first')
+    tracks = [item for listing in navigation.get('lists', [])
+              for item in listing.get('items', [])
+              if isinstance(item, dict) and item.get('type') == 'song'
+              and item.get('service') == 'cd_controller']
+    disc = subprocess.run(['cd-discid', '/dev/cdrom'], capture_output=True,
+                          text=True, check=True, timeout=6).stdout.split()
+    if len(disc) < 2 or not tracks or int(disc[1]) != len(tracks):
+        raise RuntimeError('CD changed - reopen Audio CD')
+    drives = []
+    roots = [(Path('/mnt/INTERNAL'), 'Internal Memory')]
+    usb = Path('/mnt/USB')
+    if usb.is_dir():
+        roots.extend((p, p.name) for p in sorted(usb.iterdir()) if p.is_mount())
+    for path, name in roots:
+        try:
+            actual = destination_path({'path': str(path)})
+            free = shutil.disk_usage(actual).free
+            drives.append({'name': name, 'path': str(path),
+                           'available': os.access(actual, os.W_OK),
+                           'availableSpace': '%.1f GB' % (free / 1024**3)})
+        except (OSError, RuntimeError):
+            continue
+    return {'rippingAvailable': True, 'cdid': disc[0],
+            'artist': meta.get('artist', ''), 'album': meta.get('album', ''),
+            'year': meta.get('year', ''), 'genre': meta.get('genre', ''),
+            'tracks': [{'number': str(i), 'title': item.get('title', ''),
+                        'artist': item.get('artist') or meta.get('artist', '')}
+                       for i, item in enumerate(tracks)],
+            'availableDrives': drives}
+
+
+def safe_name(value, fallback):
+    text = re.sub(r'[<>:"/\\|?*\x00-\x1f]', '_', str(value or '')).strip(' .')
+    return (text or fallback)[:100]
+
+
+def encoder_command(wav, output, fmt, info, track, number):
+    if fmt not in ('flac', 'mp3'):
+        raise ValueError('Unknown rip format')
+    args = ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-n',
+            '-i', str(wav), '-map', '0:a:0', '-threads', '1']
+    if fmt == 'flac':
+        args += ['-c:a', 'flac', '-compression_level', '8']
+    else:
+        args += ['-c:a', 'libmp3lame', '-b:a', '320k', '-id3v2_version', '3']
+    tags = {'title': track.get('title') or 'Track %d' % number,
+            'artist': track.get('artist') or info.get('artist', ''),
+            'album': info.get('album', ''), 'date': info.get('year', ''),
+            'genre': info.get('genre', ''), 'track': str(number)}
+    for key, value in tags.items():
+        if value:
+            args += ['-metadata', '%s=%s' % (key, value)]
+    return args + ['-f', fmt, str(output)]
+
+
+def start_rip(info, drive, fmt, notify, stop_cd):
+    """Validate the menu selection and launch one background job. Never auto-rip."""
+    if (fmt not in ('flac', 'mp3') or not isinstance(info, dict)
+            or not info.get('rippingAvailable') or not isinstance(drive, dict)
+            or not drive.get('available') or drive not in info.get('availableDrives', [])):
+        return False
+    if not _BUSY.acquire(blocking=False):
+        notify('A CD rip is already running')
+        return True
+    try:
+        _CANCEL.clear()
+        thread = threading.Thread(target=_run, args=(dict(info), dict(drive), fmt,
+                                  notify, stop_cd), daemon=True, name='sable-cd-rip')
+        thread.start()
+        return True
+    except Exception:
+        _BUSY.release()
+        return False
+
+
+def _run(info, drive, fmt, notify, stop_cd):
+    lockfile = None
+    folder = None
+    status_file = STATUS_FILE
+    def report(message, progress=None):
+        global _PROGRESS
+        _PROGRESS = {'progress': progress}
+        try:
+            payload = {'message': message, 'format': fmt,
+                       'folder': str(folder) if folder else '', 'updated': time.time(), 'progress': progress}
+            tmp = status_file.with_suffix('.tmp')
+            tmp.write_text(json.dumps(payload))
+            tmp.replace(status_file)
+        except OSError:
+            pass
+        notify(message)
+    try:
+        lockfile = open(LOCK_FILE, 'a')
+        try:
+            fcntl.flock(lockfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise RuntimeError('A CD rip is already running')
+        if subprocess.run(['pgrep', '-x', 'abcde'], stdout=subprocess.DEVNULL).returncode == 0:
+            raise RuntimeError('Volumio is already ripping a CD')
+        for tool in ('cdparanoia', 'cd-discid', 'ffmpeg'):
+            if not shutil.which(tool):
+                raise RuntimeError('Missing ripping tool: ' + tool)
+        destination = destination_path(drive)
+        if not os.access(destination, os.W_OK):
+            raise RuntimeError('Destination is not writable')
+        if shutil.disk_usage(destination).free < 1024**3:
+            raise RuntimeError('At least 1 GB free is needed')
+        disc = subprocess.run(['cd-discid', '/dev/cdrom'], capture_output=True,
+                              text=True, check=True, timeout=20).stdout.split()
+        tracks = info.get('tracks') or []
+        if not disc or disc[0].lower() != str(info.get('cdid', '')).lower():
+            raise RuntimeError('CD changed - reopen Audio CD')
+        if len(disc) < 2 or int(disc[1]) != len(tracks) or not tracks:
+            raise RuntimeError('CD track information is incomplete')
+        if _CANCEL.is_set():
+            raise RipCancelled()
+        offsets = [int(value) for value in disc[2:2 + len(tracks)]]
+        endpoints = offsets[1:] + [int(disc[-1]) * 75]
+        lengths = [max(1, end - start) for start, end in zip(offsets, endpoints)]
+        if len(lengths) != len(tracks):
+            raise RuntimeError('CD timing information is incomplete')
+        stop_cd()
+        parent = destination / 'CD Rips' / safe_name(info.get('artist'), 'Unknown Artist')
+        parent.mkdir(parents=True, exist_ok=True)
+        prefix = safe_name(info.get('album'), 'Unknown Album') + (' - HQ ' if fmt == 'flac' else ' - MP3 ')
+        folder = Path(tempfile.mkdtemp(prefix=prefix, dir=str(parent)))
+        # mkdtemp defaults to 0700; MPD runs as a different user.
+        folder.chmod(0o755)
+        for index, track in enumerate(tracks, 1):
+            if not isinstance(track, dict):
+                raise RuntimeError('Invalid track information')
+            reading = 'Reading track %d/%d' % (index, len(tracks))
+            encoding = 'Encoding track %d/%d' % (index, len(tracks))
+            report(reading, 0.0)
+            with tempfile.TemporaryDirectory(prefix='.track-', dir=str(folder)) as temp:
+                wav = Path(temp) / 'audio.wav'
+                last_update = [0.0]
+                def update(message, fraction):
+                    now = time.monotonic()
+                    if now - last_update[0] >= 0.5:
+                        last_update[0] = now
+                        report(message, fraction)
+                # The bar represents two measured stages, half read / half encode.
+                _run_command(['cdparanoia', '-d', '/dev/cdrom', '-w', str(index), str(wav)],
+                             timeout=1800, on_poll=lambda: update(reading,
+                                 0.5 * read_fraction(wav, lengths[index - 1] * 2352)))
+                report(encoding, 0.5)
+                name = '%02d - %s.%s' % (index, safe_name(track.get('title'), 'Track %d' % index), fmt)
+                output = folder / name
+                partial = folder / (name + '.part')
+                progress_file = Path(temp) / 'encode-progress.txt'
+                command = encoder_command(wav, partial, fmt, info, track, index)
+                command[1:1] = ['-progress', str(progress_file), '-stats_period', '0.25']
+                _run_command(command, timeout=900, on_poll=lambda: update(encoding,
+                    0.5 + 0.5 * encode_fraction(progress_file, lengths[index - 1] / 75.0)))
+                partial.chmod(0o644)
+                partial.rename(output)
+                report('Saved track %d/%d' % (index, len(tracks)), 1.0)
+        report('Rip complete: %d tracks (%s)' % (len(tracks), fmt.upper()), 1.0)
+    except RipCancelled:
+        report('Rip cancelled - saved tracks kept')
+    except subprocess.TimeoutExpired:
+        report('Rip stopped: drive/encoder timed out')
+    except subprocess.CalledProcessError as exc:
+        report('Rip failed: ' + Path(str(exc.cmd[0])).name)
+    except Exception as exc:
+        report('Rip failed: ' + str(exc))
+    finally:
+        if lockfile is not None:
+            lockfile.close()
+        _BUSY.release()
