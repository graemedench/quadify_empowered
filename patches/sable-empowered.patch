@@ -199,8 +219,13 @@ log "installing $UNIT_DST"
 $SUDO tee "$UNIT_DST" < "$UNIT_SRC" >/dev/null
 log "installing $BOOT_UNIT_DST"
 $SUDO tee "$BOOT_UNIT_DST" < "$BOOT_UNIT_SRC" >/dev/null
+log "installing $INDICATOR_UNIT_DST"
+$SUDO tee "$INDICATOR_UNIT_DST" < "$INDICATOR_UNIT_SRC" >/dev/null
+log "installing Sable recovery commands"
+$SUDO install -o root -g root -m 0755 "$SABLE_DIR/bin/sable-backup.sh" /usr/local/bin/sable-backup
+$SUDO install -o root -g root -m 0755 "$SABLE_DIR/bin/sable-repair.sh" /usr/local/bin/sable-repair
