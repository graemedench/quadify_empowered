+# --- Navigation inactivity ---------------------------------------------------
+
+def test_entering_navigation_arms_the_ten_second_timer():
+    app = _app()
+    app.fsm.go("menu")
+    assert app.fsm.menu_inactivity_s == 10.0
+    assert app.fsm._menu_timer is not None
+    app.fsm._cancel_menu_timer()
+
+
+
+def test_navigation_timeout_returns_to_now_playing_when_active():
+    app = _app()
+    _set(app, status="play", service="mpd")
+    app.fsm.go("browse")
+    app.fsm._menu_expired()
+    assert app.fsm.current.name == "modern"
+
+
+def test_navigation_timeout_returns_to_clock_when_stopped():
+    app = _app()
+    app.fsm.go("browse")
+    app.fsm._menu_expired()
+    assert app.fsm.current.name == "clock"
+
+# --- Audio-first display hand-off --------------------------------------------
+
+def test_playback_settle_defers_nowplaying_screen():
+    app = _app()
+    app.fsm.go("clock")
+    app._first_state = False
+    _set(app, status="stop")
+    app._on_state(PlayerState(status="stop"), PlayerState(status="play", service="mpd"))
+    assert app.fsm.current.name == "clock"
+    assert app._playback_settle_timer is not None
+    _set(app, status="play", service="mpd")
+    app._last_switch_t = 0
+    app._playback_settle_fire()
+    assert app.fsm.current.name == "modern"
+
+
+def test_playback_settle_forces_a_redraw_when_already_on_nowplaying():
+    app = _app()
+    app.fsm.go("modern")
+    _set(app, status="play", service="mpd")
+    rendered = []
+    app.render = lambda: rendered.append(True)
+    app._playback_settle_fire()
+    assert rendered == [True]
+
+
+def test_track_change_while_playing_rearms_playback_settle():
+    app = _app()
+    app._first_state = False
+    old = PlayerState(status="play", service="mpd", uri="old-stream", title="Old")
+    new = PlayerState(status="play", service="mpd", uri="new-stream", title="New")
+    app._on_state(old, new)
+    assert app._playback_settle_timer is not None
+    app._cancel_playback_settle()
+
