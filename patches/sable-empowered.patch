diff --git a/bin/sable-backup.sh b/bin/sable-backup.sh
new file mode 100755
index 0000000..2c6e947
--- /dev/null
+++ b/bin/sable-backup.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+# Create a portable snapshot of Sable before a Volumio or Sable update.
+set -euo pipefail
+
+SABLE_DIR="${SABLE_DIR:-/home/volumio/sable}"
+BACKUP_DIR="${SABLE_BACKUP_DIR:-/data/sable-backups}"
+STAMP="$(date +%Y%m%d-%H%M%S)"
+ARCHIVE="$BACKUP_DIR/sable-$STAMP.tar.gz"
+SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
+
+[ -d "$SABLE_DIR" ] || { echo "Sable is not present at $SABLE_DIR" >&2; exit 1; }
+$SUDO mkdir -p "$BACKUP_DIR"
+$SUDO tar -C / --ignore-failed-read \
+  --exclude='home/volumio/sable/.git' \
+  -czf "$ARCHIVE" \
+  home/volumio/sable \
+  etc/systemd/system/sable.service \
+  etc/systemd/system/sable-boot-indicator.service \
+  etc/systemd/system/sable-boot-splash.service \
+  boot/userconfig.txt 2>/dev/null
+$SUDO chown volumio:volumio "$ARCHIVE" 2>/dev/null || true
+
+# Keep the five most recent snapshots; the current one is always retained.
+$SUDO find "$BACKUP_DIR" -maxdepth 1 -type f -name 'sable-*.tar.gz' -printf '%T@ %p\n' \
+  | sort -nr | tail -n +6 | cut -d' ' -f2- | xargs -r $SUDO rm -f
+
+echo "Sable backup created: $ARCHIVE"
\ No newline at end of file
diff --git a/bin/sable-repair.sh b/bin/sable-repair.sh
new file mode 100755
index 0000000..cf73dec
--- /dev/null
+++ b/bin/sable-repair.sh
@@ -0,0 +1,15 @@
+#!/bin/bash
+# Reinstall Sable's system integration after an update, preserving settings.
+set -euo pipefail
+
+SABLE_DIR="${SABLE_DIR:-/home/volumio/sable}"
+[ -d "$SABLE_DIR/src/sable" ] || { echo "Sable code is not present at $SABLE_DIR" >&2; exit 1; }
+
+if command -v sable-backup >/dev/null 2>&1; then
+  sable-backup
+fi
+
+cd "$SABLE_DIR"
+SABLE_DIR="$SABLE_DIR" bash install.sh
+sudo systemctl restart sable.service
+echo "Sable has been repaired and restarted."
\ No newline at end of file
