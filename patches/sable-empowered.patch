+"""CD integration and independent clock startup regression tests."""
+import os
+import sys
+import time
+from unittest.mock import Mock, patch
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+from PIL import Image, ImageDraw
+from sable.app import build_sim_app, _boot_ready
+from sable.screens.home import _icon_name
+from sable.screens.browse import _play_all_tracks
+from sable.volumio.listener import VolumioListener
+
+def setup():
+    app = build_sim_app(frames_dir=None)
+    app.display.ascii_preview = False
+    app.listener = Mock()
+    app.listener.browse_sources = []
+    app.go("browse")
+    return app, app.fsm.screens["browse"]
+
+def response(enabled=True):
+    return {"navigation": {"lists": [{"items": [
+        {"title": "Track 1", "uri": "cdaudio/track0", "type": "song"},
+        {"title": "Track 2", "uri": "cdaudio/track1", "type": "song"}]}],
+        "rip": {"enabled": enabled, "data": {
+            "endpoint": "music_service/cd_controller", "method": "getRipInfo"}}}}
+
+def options():
+    return {"album": "Document", "artist": "R.E.M.", "cdid": "c70fdf11",
+            "tracks": [{"number": "0", "title": "Track 1"}],
+            "rippingAvailable": True, "availableDrives": [
+                {"path": "/mnt/INTERNAL", "name": "Internal Memory", "available": True}]}
+
+def load_cd(b, enabled=True):
+    b.loading = True
+    b._replace_top = True
+    b._pending_title = "Audio CD"
+    b.on_browse_data(response(enabled))
+
+def test_cd_menu_and_rip_destination():
+    app, b = setup()
+    load_cd(b)
+    assert [i["title"] for i in b._cur["items"]][:3] == ["Play all", "Rip HQ", "Rip MP3"]
+    assert len(_play_all_tracks(b._cur["items"])) == 2
+    b._cur["index"] = 1
+    b.handle_select()
+    app.listener.request_cd_rip_info.assert_called_once()
+    b.on_rip_info(options())
+    app.listener.rip_cd.assert_not_called()
+    assert b._cur["title"] == "Document"
+    assert b._cur["items"][0]["title"] == "Rip to Internal Memory"
+    b.handle_select()
+    app.listener.rip_cd.assert_called_once_with(options(), options()["availableDrives"][0], "flac")
+    assert b._cur["items"][0]["title"] == "Rip requested"
+    b.on_rip_status({"message": "Ripping finished"})
+    assert b._cur["items"][0]["title"] == "Ripping finished"
+
+def test_disabled_ripping_not_offered():
