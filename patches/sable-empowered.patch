+# Apple aluminium IR remote captured from this Sable unit's HS0038 receiver.
+begin remote
+  name  Apple_Aluminium_Sable
+  bits            8
+  flags SPACE_ENC|CONST_LENGTH
+  eps            30
+  aeps          100
+  header       9065  4484
+  one           574  1668
+  zero          574   547
+  ptrail        567
+  repeat       9031  2242
+  pre_data_bits   16
+  pre_data       0x77E1
+  post_data_bits  8
+  post_data      0x5D
+  gap          108000
+  toggle_bit_mask 0x0
+  begin codes
+      KEY_MENU   0xC0
+      KEY_PLAY   0xFA 0xA0
+      KEY_ENTER  0x3A 0xA0
+      KEY_LEFT   0x90
+      KEY_RIGHT  0x60
+      KEY_DOWN   0x30
+      KEY_UP     0x50
+  end codes
+end remote
