+        # above to clear one from the previous screen. Arm the new timer only
+        # after the target screen is committed and visibly rendered.
+        if self.current is not None and self.current.name in ("menu", "home", "browse"):
+            self.reset_menu_timer()
+
+    def dispatch(self, event):
+        """Apply a table-driven transition for `event` from the current state."""
+        cur = self.current.name if self.current is not None else None
+        target = TABLE.get(cur, {}).get(event)
+        if target == NOWPLAYING:
+            target = self.app.nowplaying_screen()
+        if target is not None:
+            self.log("fsm: %s --%s--> %s" % (cur, event, target))
+            self.go(target)
+        return target
+
+    # --- navigation inactivity (home/menu/browse -> base screen after N seconds) ---
+    def reset_menu_timer(self):
+        self._cancel_menu_timer()
+        self._menu_timer = threading.Timer(self.menu_inactivity_s, self._menu_expired)
+        self._menu_timer.daemon = True
+        self._menu_timer.start()
+
+    def _cancel_menu_timer(self):
+        if self._menu_timer:
+            self._menu_timer.cancel()
+            self._menu_timer = None
+
+    def _menu_expired(self):
+        # A browsing overlay should never be left obscuring the music screen.
+        # `base_screen` resolves dynamically: Now Playing while audio is active,
+        # otherwise the clock. Re-checking current prevents a stale Timer from
+        # yanking the display away after a user has already navigated elsewhere.
+        if self.current is not None and self.current.name in ("menu", "home", "browse"):
+            if self.current.name == "browse" and (self.current.loading or self.current.rip_in_progress):
+                self.reset_menu_timer()
+                return
+            self.app.go(self.app.base_screen())
