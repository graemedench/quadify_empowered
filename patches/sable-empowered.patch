--- /dev/null
+++ b/src/sable/inputs/power.py
@@ -0,0 +1,64 @@
+"""Dedicated BCM21 shutdown input.
+
+The Pi image can read BCM21 but rejects RPi.GPIO edge-registration on it. A
+small polling loop avoids that kernel limitation while preserving a deliberate
+active-low, two-second hold before requesting Sable's graceful shutdown.
+"""
+import threading
+import time
+
+
+class PowerButton:
+    def __init__(self, pin, handle, hold_time=2.0, poll_s=0.05, log=print):
+        import RPi.GPIO as GPIO
+
+        self.pin = pin
+        self.handle = handle
+        self.hold_time = hold_time
+        self.poll_s = poll_s
+        self.log = log
+        self._GPIO = GPIO
+        self._running = False
+        self._thread = None
+        self.available = False
+        GPIO.setmode(GPIO.BCM)
+        GPIO.setwarnings(False)
+        try:
+            GPIO.setup(pin, GPIO.IN, pull_up_down=GPIO.PUD_UP)
+            self.available = True
+            self._running = True
+            self._thread = threading.Thread(target=self._monitor, daemon=True,
+                                            name="sable-power-pin")
+            self._thread.start()
+        except RuntimeError as exc:
+            self.log("power pin BCM%d unavailable; shutdown input disabled: %s"
+                     % (pin, exc))
+
+    def _monitor(self):
+        pressed_since = None
+        fired = False
+        while self._running:
+            try:
+                pressed = self._GPIO.input(self.pin) == self._GPIO.LOW
+            except Exception as exc:
+                self.log("power pin BCM%d read failed: %s" % (self.pin, exc))
+                return
+            now = time.monotonic()
+            if not pressed:
+                pressed_since = None
+                fired = False
+            elif pressed_since is None:
+                pressed_since = now
+            elif not fired and now - pressed_since >= self.hold_time:
+                fired = True
+                self.log("power pin BCM%d held; requesting shutdown" % self.pin)
+                try:
+                    self.handle("shutdown")
+                except Exception as exc:
+                    self.log("power pin shutdown request failed:", exc)
+            time.sleep(self.poll_s)
+
+    def close(self):
+        self._running = False
+        if self._thread is not None:
+            self._thread.join(timeout=self.poll_s * 3)
