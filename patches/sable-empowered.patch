+    app._first_state = False
+    old = PlayerState(status="play", service="mpd", uri="old-stream", title="Old")
+    new = PlayerState(status="play", service="mpd", uri="new-stream", title="New")
+    app._on_state(old, new)
+    assert app._playback_settle_timer is not None
+    app._cancel_playback_settle()
