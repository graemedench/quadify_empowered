+            "volumestart": {"value": "50" if mixer_type == "Software" else "disabled"},
+            "volumemax": {"value": "100"}, "volumesteps": {"value": "1"},
+            "volumecurvemode": {"value": "logarithmic"}, "mpdvolume": mixer_type == "Software",
+        }
