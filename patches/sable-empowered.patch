index 0000000..8264174
--- /dev/null
+++ b/tests/test_clock_storage.py
@@ -0,0 +1,73 @@
+"""Clock verification and Volumio storage alias regressions."""
+import os
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+from unittest.mock import patch
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+from sable import clock_gate, cd_rip
+
+
+def peers(offsets=(2, -3, 1), age='2', reach='17', jitter=1):
+    lines=['remote refid st t when poll reach delay offset jitter', '==========']
+    for i, offset in enumerate(offsets):
+        lines.append('192.0.2.%d ref 2 u %s 64 %s 12 %s %s' %
+                     (i+1, age, reach, offset, jitter))
+    return '\n'.join(lines)
+
+
+def check_peers(text):
+    with patch.object(clock_gate.subprocess, 'run', return_value=SimpleNamespace(stdout=text)):
+        return clock_gate._peers_confirm_time()
+
+
+def test_three_fresh_agreeing_peers_confirm_time():
+    assert check_peers(peers())
+    with patch.object(clock_gate.subprocess, 'run', side_effect=[
+            SimpleNamespace(stdout='leap_alarm sync_unspec offset=0.0'),
+            SimpleNamespace(stdout=peers())]):
+        assert clock_gate._ntpq_synced()
+
+
+def test_wrong_stale_unreachable_and_sparse_samples_rejected():
+    assert not check_peers(peers((26000,26001,25999)))
+    assert not check_peers(peers(age='2m'))
+    assert not check_peers(peers(age='100'))
+    assert not check_peers(peers(reach='0'))
+    assert not check_peers(peers((1,2)))
+    assert not check_peers(peers((-100,0,100)))
+    assert not check_peers(peers(jitter=999))
+    assert not check_peers(peers((float('nan'),1,2)))
+
+
+def test_volumio_aliases_and_library_paths():
+    with tempfile.TemporaryDirectory() as temp:
+        root=Path(temp); internal=root/'data'/'INTERNAL'; usb=root/'media'; pen=usb/'MYUSB'
+        internal.mkdir(parents=True);pen.mkdir(parents=True)
+        original=Path.resolve
+        def resolve(path, *args, **kwargs):
+            return {'/mnt/INTERNAL':internal, '/data/INTERNAL':internal,
+                    '/mnt/USB':usb, '/mnt/USB/MYUSB':pen,
+                    '/media/MYUSB':pen}.get(str(path), original(path,*args,**kwargs))
+        with patch.object(Path,'resolve',resolve), patch.object(cd_rip.os.path,'ismount',return_value=True):
+            for alias in ('/mnt/INTERNAL','/data/INTERNAL'):
+                assert cd_rip.destination_path({'path':alias}) == internal
+                assert cd_rip.library_path({'path':alias}) == 'INTERNAL/CD Rips'
+            for alias in ('/mnt/USB/MYUSB','/media/MYUSB'):
+                assert cd_rip.destination_path({'path':alias}) == pen
+                assert cd_rip.library_path({'path':alias}) == 'USB/MYUSB/CD Rips'
+            for bad in ('', '/', '/etc', '/mnt/USB'):
+                try: cd_rip.destination_path({'path':bad})
+                except RuntimeError: pass
+                else: raise AssertionError('Unsafe destination accepted: '+bad)
+        with patch.object(Path,'resolve',resolve), patch.object(cd_rip.os.path,'ismount',return_value=False):
+            try: cd_rip.destination_path({'path':'/media/MYUSB'})
+            except RuntimeError: pass
+            else: raise AssertionError('Unmounted USB accepted')
+
+
+if __name__ == '__main__':
+    for name,test in sorted(globals().copy().items()):
+        if name.startswith('test_'):
+            test(); print('PASS',name)
