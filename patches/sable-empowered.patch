@@ -0,0 +1,149 @@
+"""Run the real FLAC/MP3 encoders on synthetic PCM; never read the CD drive."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import wave
+from unittest.mock import Mock, patch
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+from sable import cd_rip
+
+
+def info():
+    return {"rippingAvailable": True, "cdid": "12345678", "artist": "Test Artist",
+            "album": "Test Album", "year": "2026", "tracks": [{"title": "Test Track"}],
+            "availableDrives": [{"available": True, "path": "/mnt/INTERNAL"}]}
+
+
+def test_invalid_requests_do_not_launch():
+    data = info()
+    notify = Mock()
+    assert not cd_rip.start_rip(data, data['availableDrives'][0], 'unknown', notify, Mock())
+    assert not cd_rip.start_rip(data, {'available': True, 'path': '/other'}, 'flac', notify, Mock())
+    assert not cd_rip._BUSY.locked()
+
+
+def test_real_encoding_and_lossless_samples():
+    real_run = subprocess.run
+    for fmt in ('flac', 'mp3'):
+        with tempfile.TemporaryDirectory(prefix='sable-rip-test-') as temp:
+            folder = Path(temp)
+            data = info()
+            notices = []
+            stop = Mock()
+            pcm = b'\x01\x02\x03\x04' * 44100
+            def run(args, **kwargs):
+                if args[0] == 'pgrep':
+                    return subprocess.CompletedProcess(args, 1)
+                if args[0] == 'cd-discid':
+                    return subprocess.CompletedProcess(args, 0, '12345678 1 150 60')
+                if args[0] == 'cdparanoia':
+                    with wave.open(args[-1], 'wb') as wav:
+                        wav.setnchannels(2); wav.setsampwidth(2); wav.setframerate(44100)
+                        wav.writeframes(pcm)
+                    return subprocess.CompletedProcess(args, 0)
+                return real_run(args, **kwargs)
+            with patch.object(cd_rip, 'destination_path', return_value=folder), \
+                 patch.object(cd_rip, 'STATUS_FILE', folder / 'status.json'), \
+                 patch.object(cd_rip, 'LOCK_FILE', str(folder / 'test.lock')), \
+                 patch.object(cd_rip, '_run_command', side_effect=lambda args, timeout, on_poll=None: run(args, timeout=timeout, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)), \
+                 patch.object(cd_rip.subprocess, 'run', side_effect=run):
+                assert cd_rip._BUSY.acquire(blocking=False)
+                cd_rip._run(data, data['availableDrives'][0], fmt, notices.append, stop)
+            assert not cd_rip._BUSY.locked()
+            assert notices[-1].startswith('Rip complete:'), notices
+            stop.assert_called_once()
+            outputs = list(folder.rglob('*.' + fmt))
+            assert len(outputs) == 1
+            assert outputs[0].parent.stat().st_mode & 0o777 == 0o755
+            assert outputs[0].stat().st_mode & 0o777 == 0o644
+            probe = json.loads(real_run(['ffprobe', '-v', 'quiet', '-show_format',
+                '-show_streams', '-of', 'json', str(outputs[0])], capture_output=True,
+                text=True, check=True).stdout)
+            stream = probe['streams'][0]
+            assert stream['sample_rate'] == '44100'
+            assert stream['channels'] == 2
+            tags = {k.lower():v for k,v in probe['format']['tags'].items()}
+            assert tags['title'] == 'Test Track' and tags['album'] == 'Test Album'
+            if fmt == 'mp3':
+                assert stream['codec_name'] == 'mp3' and int(stream['bit_rate']) == 320000
+            else:
+                assert stream['codec_name'] == 'flac'
+                decoded = real_run(['ffmpeg', '-v', 'error', '-i', str(outputs[0]),
+                    '-f', 's16le', '-'], capture_output=True, check=True).stdout
+                assert decoded == pcm, 'HQ rip must preserve PCM samples exactly'
+            assert not list(folder.rglob('*.part'))
+            assert not list(folder.rglob('.track-*'))
+
+
+def test_wrong_disc_does_not_stop_playback_or_write_music():
+    with tempfile.TemporaryDirectory(prefix='sable-rip-test-') as temp:
+        folder = Path(temp); stop = Mock(); notices = []
+        data = info()
+        def run(args, **kwargs):
+            return subprocess.CompletedProcess(args, 1 if args[0] == 'pgrep' else 0,
+                                               'different 1 150 60')
+        with patch.object(cd_rip, 'destination_path', return_value=folder), \
+             patch.object(cd_rip, 'STATUS_FILE', folder / 'status.json'), \
+                 patch.object(cd_rip, 'LOCK_FILE', str(folder / 'test.lock')), \
+                 patch.object(cd_rip, '_run_command', side_effect=lambda args, timeout, on_poll=None: run(args, timeout=timeout, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)), \
+             patch.object(cd_rip.subprocess, 'run', side_effect=run):
+            assert cd_rip._BUSY.acquire(blocking=False)
+            cd_rip._run(data, data['availableDrives'][0], 'flac', notices.append, stop)
+        assert 'CD changed' in notices[-1]
+        stop.assert_not_called()
+        assert not (folder / 'CD Rips').exists()
+        assert not cd_rip._BUSY.locked()
+
+
+def test_cancel_terminates_child_process():
+    real_popen = subprocess.Popen
+    children = []
+    def spawn(*args, **kwargs):
+        child = real_popen(*args, **kwargs)
+        children.append(child)
+        return child
+    cd_rip._CANCEL.clear()
+    timer = threading.Timer(0.3, cd_rip._CANCEL.set)
+    timer.start()
+    started = time.monotonic()
+    try:
+        with patch.object(cd_rip.subprocess, 'Popen', side_effect=spawn):
+            try:
+                cd_rip._run_command([sys.executable, '-c', 'import time; time.sleep(30)'], timeout=40)
+            except cd_rip.RipCancelled:
+                pass
+            else:
+                raise AssertionError('Cancellation was not propagated')
+        assert time.monotonic() - started < 5
+        assert children and children[0].poll() is not None
+    finally:
+        timer.cancel()
+        cd_rip._CANCEL.clear()
+
+
+def test_measured_track_progress():
+    with tempfile.TemporaryDirectory(prefix='sable-progress-test-') as temp:
+        wav = Path(temp) / 'track.wav'
+        progress = Path(temp) / 'progress.txt'
+        assert cd_rip.read_fraction(wav, 1000) == 0
+        wav.write_bytes(bytes(544))
+        assert cd_rip.read_fraction(wav, 1000) == .5
+        assert cd_rip.encode_fraction(progress, 10) == 0
+        progress.write_text('out_time_us=2500000\nprogress=continue\n')
+        assert cd_rip.encode_fraction(progress, 10) == .25
+        progress.write_text('out_time_us=10000000\nprogress=end\n')
+        assert cd_rip.encode_fraction(progress, 10) == 1
+        polls = []
+        cd_rip._run_command([sys.executable, '-c', 'import time; time.sleep(.3)'],
+                            timeout=5, on_poll=lambda: polls.append(True))
+        assert len(polls) >= 2
+
+if __name__ == '__main__':
+    for name, test in sorted(globals().copy().items()):
+        if name.startswith('test_'):
+            test(); print('PASS', name)
