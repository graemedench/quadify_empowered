--- a/install-moode.sh
+++ b/install-moode.sh
@@ -99,10 +99,8 @@ else
 fi
 
 # 4. Kernel overlays (written now; take effect on the next REBOOT) -----------
-# SPI (OLED), I2C (buttons/LEDs), gpio-ir (IR BCM4). gpio-shutdown wires a safe
-# power-off button on BCM17 -- remove that line if your board has nothing on
-# BCM17 and powers off / won't stay up. Audio (USB/HAT/HDMI) is moOde's
-# concern -- no audio overlay here. On Bookworm+ (moOde 9) the boot partition
+# SPI (OLED), I2C (buttons/LEDs), gpio-ir (IR BCM4), and the existing BCM17
+# gpio-shutdown overlay. Sable uses separate BCM21 for graceful shutdown. On Bookworm+ (moOde 9) the boot partition
 # is mounted at /boot/firmware and THAT config.txt is the one the bootloader
 # reads -- a stale, inert /boot/config.txt stub can also exist and silently
 # eat writes that never take effect (verified on a real moOde 9 Pi 4: SPI/I2C
diff --git a/install.sh b/install.sh
index e0b8de5..b83ae79 100755
--- a/install.sh
+++ b/install.sh
@@ -14,11 +14,21 @@
 # manager calls it -- sudo is used only when not already root.
 set -uo pipefail
 
+GRAEME_PRESET=0
+for arg in "$@"; do
+    case "$arg" in
+        --graeme) GRAEME_PRESET=1 ;;
+        *) echo "FATAL: unknown option: $arg (supported: --graeme)"; exit 2 ;;
+    esac
+done
+
 SABLE_DIR="${SABLE_DIR:-/home/volumio/sable}"
 UNIT_SRC="$SABLE_DIR/systemd/sable.service"
 UNIT_DST="/etc/systemd/system/sable.service"
 BOOT_UNIT_SRC="$SABLE_DIR/systemd/sable-boot-splash.service"
 BOOT_UNIT_DST="/etc/systemd/system/sable-boot-splash.service"
+INDICATOR_UNIT_SRC="$SABLE_DIR/systemd/sable-boot-indicator.service"
+INDICATOR_UNIT_DST="/etc/systemd/system/sable-boot-indicator.service"
 DISABLED_DIR="$SABLE_DIR/disabled-units"
 USERCONFIG="/boot/userconfig.txt"
 APT_OPTS="-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
@@ -31,9 +41,19 @@ warn() { echo "[sable-install] WARN: $*" >&2; }
 # 0. Preconditions -----------------------------------------------------------
 [ -d "$SABLE_DIR/src/sable" ] || { echo "FATAL: Sable code not found at $SABLE_DIR (clone it first)"; exit 1; }
 [ -f "$UNIT_SRC" ]           || { echo "FATAL: unit file missing at $UNIT_SRC"; exit 1; }
+[ -f "$INDICATOR_UNIT_SRC" ] || { echo "FATAL: early boot indicator unit missing at $INDICATOR_UNIT_SRC"; exit 1; }
 command -v python3 >/dev/null || { echo "FATAL: python3 not found"; exit 1; }
 [ -n "$SUDO" ] && { log "may prompt for the 'volumio' sudo password ..."; sudo -v || { echo "FATAL: sudo required"; exit 1; }; }
 
+# The personal option deliberately changes settings only: hardware wiring stays
+# machine-specific. It restores Graeme's audio/menu profile and 5-7 shortcuts.
+if [ "$GRAEME_PRESET" -eq 1 ]; then
+    PRESET="$SABLE_DIR/config/settings.graeme.json"
+    [ -f "$PRESET" ] || { echo "FATAL: Graeme preset missing: $PRESET"; exit 1; }
+    $SUDO install -o volumio -g volumio -m 0644 "$PRESET" "$SABLE_DIR/config/settings.json"
+    log "applied Graeme FM4 settings and shortcut defaults"
+fi
+
 # 1. Heal apt + system packages ----------------------------------------------
 # Heal any half-configured dpkg state from a previous run, and drop the dead
 # nodesource repo that makes `apt-get update` fail on Volumio bookworm.
@@ -185,7 +205,7 @@ fi
 
 # 4. Retire conflicting quadify units IF present (kept, just moved aside) -----
 mkdir -p "$DISABLED_DIR"
-for u in quadify.service cava.service quadify-buttonsleds.service ir_listener.service; do
