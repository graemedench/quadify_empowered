+        # item first, so we can re-queue exactly this track/station afterwards.
+        st = self.store.get()
+        resume_item = None
+        if st.status in ("play", "pause") and st.uri:
+            resume_item = {"uri": st.uri, "title": st.title,
+                           "service": st.service,
+                           "type": "webradio" if st.service == "webradio" else "song"}
+            if st.albumart:
+                resume_item["albumart"] = st.albumart
+        try:
