+Wants=network.target volumio.service
 Conflicts=quadify.service sable-boot-splash.service
 
 [Service]
@@ -22,7 +17,16 @@ Environment=PYTHONPATH=/home/volumio/sable/src
 # --stage full = clock + live Volumio listener + rotary + live CAVA spectrum
 # (Sable's own cava on MPD's /tmp/cava.fifo). run_hardware handles SIGTERM and
